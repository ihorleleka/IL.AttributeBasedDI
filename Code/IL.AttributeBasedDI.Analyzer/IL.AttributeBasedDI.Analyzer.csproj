<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Analyzers run inside the compiler, independently of the consuming project's TFM. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <TargetFrameworks></TargetFrameworks>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>IL.AttributeBasedDI.ServiceLifetimeAnalyzer</RootNamespace>

        <PackageId>IL.AttributeBasedDI.Analyzer</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- SDK 10 hosts Roslyn 5.0; newer compiler APIs would prevent loading in .NET 10 consumers. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
